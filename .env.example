# Copier ce fichier en .env.local (jamais versionné) et remplir les valeurs.

# Neon → Dashboard → Connection string (pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secret des sessions admin : 32 caractères minimum (ex. `openssl rand -base64 48`)
AUTH_SECRET=

# Vercel → Storage → Blob → token (sans lui, en local, les fichiers vont dans public/uploads)
BLOB_READ_WRITE_TOKEN=

# Optionnel : copie de chaque message de contact vers un webhook (n8n, Make…)
CONTACT_WEBHOOK_URL=
